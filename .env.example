# Microsoft Entra ID app registration values. Keep the client secret server-side.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=http://localhost:8080/api/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URL=http://localhost:8080/

# Replace these values before deploying beyond a local workstation.
SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTHORIZATION_SERVICE_TOKEN=replace-with-a-long-random-service-token
IDENTITY_PROVISIONING_TOKEN=replace-with-a-different-random-service-token
AUTHORIZATION_ADMIN_TOKEN=replace-with-a-separate-admin-token
ERIS_DIRECTORY_SERVICE_TOKEN=replace-with-a-different-random-service-token
# OpenFGA embeds this in a PostgreSQL URI; use URL-safe characters only.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Used only by the identity service for directory, audit, outbox, and session tables.
# Changing it on an existing volume requires an explicit database credential rotation.
IDENTITY_DB_PASSWORD=replace-with-a-different-strong-database-password

# Local HTTP uses non-secure cookies. Set true when deploying behind HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
AUTH_ALLOWED_RETURN_ORIGINS=http://localhost:8080
CDEX_APP_URL=/crm/
BILS_APP_URL=/billing/
ERIS_APP_URL=/eris/
ERIS_APP_AVAILABLE=true
CUBE_PUBLIC_URL=http://localhost:8080
# Production example: set COOKIE_SECURE=true, COOKIE_DOMAIN=.yourdomain.com,
# AUTH_ALLOWED_RETURN_ORIGINS=https://yourdomain.com,https://cdex.yourdomain.com,https://bils.yourdomain.com,https://eris.yourdomain.com
# CUBE_PUBLIC_URL=https://yourdomain.com, CDEX_APP_URL=https://cdex.yourdomain.com/,
# BILS_APP_URL=https://bils.yourdomain.com/, and ERIS_APP_URL=https://eris.yourdomain.com/.
# RDES_APP_URL can be set after that app is built and deployed.
HTTP_PORT=8080
NPM_ADMIN_EMAIL=admin@cgsi.local
NPM_ADMIN_PASSWORD=replace-with-a-unique-random-password
NPM_HTTPS_PORT=8443
NPM_UI_PORT=8181
DEPLOYMENT_ENVIRONMENT=development
OPENBAO_PORT=8200

# Local infrastructure tools. These services bind to 127.0.0.1 on the host.
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=cgsi
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ROOT_USER=cgsi-local
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
GRAFANA_PORT=3000
OPENFGA_HTTP_PORT=8180
OPENFGA_CONSOLE_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JENKINS_PORT=8081
